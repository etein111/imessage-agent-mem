# LangGraph AI Agent - 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== Google Cloud 配置 ====================
# Google Cloud 项目 ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud 认证文件路径
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ==================== LLM 配置 ====================
# 模型名称
LLM_MODEL=gemini-2.0-flash-exp

# 温度参数 (0.0-1.0)
LLM_TEMPERATURE=0.7

# ==================== AI 人设配置 ====================
# 可选值: yunduo（云朵）, youci（由此）
PERSONA_NAME=yunduo

# ==================== 记忆配置 ====================
# 最大记忆保留数量
MEMORY_MAX_ITEMS=10

# ==================== API 配置 ====================
# LangGraph API 端口
LANGGRAPH_API_PORT=2024

# LangGraph API 主机
LANGGRAPH_API_HOST=0.0.0.0

# ==================== 其他配置 ====================
# LangSmith (可选 - 用于调试和监控)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=your-project-name

